{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/core/**/*",
    "src/shared/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "tests/core/**/*",
    "tests/main/**/*",
    "tests/helpers/**/*",
    "tests/bench/**/*",
    "e2e/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.bench.config.ts",
    "playwright.config.ts"
  ]
}
