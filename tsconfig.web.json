{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": [
    "src/renderer/**/*",
    "src/core/**/*",
    "src/shared/**/*",
    "src/main/**/*",
    "src/preload/api.d.ts",
    "tests/ui/**/*"
  ]
}
